{
  "name": "medmap-backend",
  "version": "1.0.0",
  "description": "MedMap REST API with PostgreSQL, PostGIS, WebSocket server, and IPFS integration",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "ws": "node src/realtime.js",
    "ws:dev": "nodemon src/realtime.js",
    "db:migrate": "knex migrate:latest --env development",
    "db:migrate:prod": "knex migrate:latest --env production",
    "db:rollback": "knex migrate:rollback --env development",
    "db:seed": "knex seed:run --env development",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/"
  },
  "keywords": [
    "geolocation",
    "healthcare",
    "routing",
    "websocket",
    "postgis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
     "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "ipfs-http-client": "^60.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.0.1",
    "pg": "^8.10.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
