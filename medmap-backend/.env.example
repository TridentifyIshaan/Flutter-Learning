# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medmap_db
DB_USER=medmap_user
DB_PASSWORD=medmap_secure_password_123
DB_POOL_MIN=2
DB_POOL_MAX=10

# Server Configuration
NODE_ENV=development
REST_PORT=3000
WS_PORT=3002

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRY=24h

# OpenRouteService (for routing/directions)
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_BASE_URL=https://api.openrouteservice.org

# IPFS Configuration (Infura)
IPFS_PROJECT_ID=your_infura_project_id_here
IPFS_PROJECT_SECRET=your_infura_project_secret_here
IPFS_GATEWAY=https://gateway.ipfs.io

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:8081

# Redis (optional, for scaling)
REDIS_URL=redis://localhost:6379
